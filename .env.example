# ---------------------------------------------------------------------------
# Tengile MalaMala — server configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# Database driver: "postgres" for production, "sqlite" for credential-free dev.
DB_DRIVER=sqlite

# --- Postgres (used when DB_DRIVER=postgres) ------------------------------
# Either provide a single connection string…
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# …or the discrete values below (DATABASE_URL takes precedence if set).
PGHOST=localhost
PGPORT=5432
PGDATABASE=tengile_enquiries
PGUSER=tengile_app
PGPASSWORD=
PGSSLMODE=require

# --- SQLite (used when DB_DRIVER=sqlite) ----------------------------------
# Path to the local database file. Defaults to ./data/enquiries.sqlite
SQLITE_PATH=./data/enquiries.sqlite

# --- Abuse protection -----------------------------------------------------
# Max enquiry submissions allowed per IP per window (see RATE_LIMIT_WINDOW_MS)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# Comma-separated list of allowed browser origins for CORS.
# Leave empty when the API serves the site from the same origin (recommended).
CORS_ORIGINS=
